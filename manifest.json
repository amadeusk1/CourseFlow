{
  "manifest_version": 3,
  "name": "D2L Tracker",
  "version": "1.0.0",
  "description": "Collect due dates from D2L and course outline PDFs, then show them on a calendar and download a .ics file.",
  "action": {
    "default_title": "D2L Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "downloads", "offscreen"],
  "host_permissions": ["https://d2l.ucalgary.ca/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": ["vendor/pdfjs/*"],
      "matches": ["https://d2l.ucalgary.ca/*"]
    }
  ]
}
